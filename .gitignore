# Rust/Tauri build artifacts (8+ GB, regenerated by `cargo build`)
src-tauri/target/
src-tauri/gen/

# Compiled binary — distribute via GitHub Releases, not the repo
IdeaCraft.exe
*.exe

# Local app data never ships
*.db
*.db-shm
*.db-wal

# OS / editor cruft
Thumbs.db
Desktop.ini
.vscode/
.idea/

# Node tooling (root dev deps: @tauri-apps/cli + playwright-core)
node_modules/

# Updater signing keys — NEVER commit these; they live in ~/.tauri/
*.key
*.key.priv
*.key.password

# npm token files that must never leak
.npmrc

# Build/release logs (keep them in Temp, not in the repo)
*.log
